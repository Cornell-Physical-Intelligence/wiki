{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "functions": { "api/index.js": { "maxDuration": 60, "includeFiles": "public/wiki-shell.html" } },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "cupi-wiki.vercel.app" }],
      "destination": "https://wiki.cornellphysicalintelligence.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "cupi-wiki.vercel.app" }],
      "destination": "https://wiki.cornellphysicalintelligence.com/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/login",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/login/",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/index.html", "destination": "/api/index" },
    { "source": "/context", "destination": "/api/index" },
    { "source": "/llms.txt", "destination": "/api/index" },
    { "source": "/llms-full.txt", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/:path((?!api).*)", "destination": "/wiki-shell.html" }
  ]
}
